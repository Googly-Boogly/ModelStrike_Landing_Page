# Copy to .env.local for `npm run dev`, or to .env for Docker Compose.
# Never commit real values.
# NEXT_PUBLIC_* values are embedded in client-visible HTML at BUILD time —
# set them before `npm run build`, and never put secrets in them.

# --- Site -------------------------------------------------------------
# Production origin, no trailing slash. Drives canonical URLs, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional public contact details. Leave empty to hide.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SECURITY_EMAIL=
# External scheduling page (Cal.com, Calendly…). Empty = "Book" buttons go to /contact.
NEXT_PUBLIC_BOOKING_URL=
# Cal.com event to embed on /contact, e.g. modelstrike/ai-security-assessment
# (or the full https://cal.com/... URL). Overrides NEXT_PUBLIC_BOOKING_URL and
# adds Cal.com's origins to the CSP automatically.
NEXT_PUBLIC_CAL_LINK=

NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_GITHUB_URL=

# --- Contact form delivery (server-only secrets) ------------------------
# One of: webhook | resend. Empty = form explains submissions aren't connected.
CONTACT_DELIVERY=

# webhook: JSON POST; optional HMAC-SHA256 signature in X-ModelStrike-Signature
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# resend: plain-text email via https://resend.com
# RESEND_API_KEY + CONTACT_FROM_EMAIL also enable a confirmation email to the
# visitor (with any CONTACT_DELIVERY); replies go to CONTACT_TO_EMAIL.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# --- Content Security Policy extensions ---------------------------------
# Space-separated origins, only when you add third-party scripts/embeds,
# e.g. privacy-friendly analytics: CSP_SCRIPT_SRC="https://plausible.io"
CSP_SCRIPT_SRC=
CSP_CONNECT_SRC=
CSP_FRAME_SRC=
